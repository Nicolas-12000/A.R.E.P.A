# Copy to .env:  cp .env.example .env
#
# --- Docker Compose (new users, default) ---
# docker compose up --build
# Uses bundled Postgres; password below must match POSTGRES_PASSWORD in compose.
POSTGRES_PASSWORD=arepa_dev
# (Compose sets AREPA_DATABASE_URL to db:5432 for the api service.)
#
# --- API only + Postgres already on your machine (port 5432) ---
# docker compose up api --build --no-deps
# AREPA_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@host.docker.internal:5432/arepa
#
# --- Run API on the host (no Docker) ---
# AREPA_DATABASE_URL=postgresql+psycopg://postgres:arepa_dev@localhost:5432/arepa
