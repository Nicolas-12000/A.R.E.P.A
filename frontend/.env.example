# Copy to .env.local:  cp .env.example .env.local
#
# auto — prueba la API al cargar; si no responde, usa modelos embebidos (ideal para Vercel).
# local — siempre predice en el navegador (sin FastAPI).
# api — solo API (comportamiento anterior).
NEXT_PUBLIC_AREPA_MODE=auto

# Solo si usas modo api o auto con backend desplegado:
NEXT_PUBLIC_API_URL=http://localhost:8000
